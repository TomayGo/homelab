[Unit]
Description=Minecraft NeoForge Server (DayTradeingTutorial)
After=network.target

[Service]
Type=forking
User=tomaygo
WorkingDirectory=/home/tomaygo/mc-server
ExecStart=/usr/bin/screen -dmS minecraft /home/tomaygo/.local/jdk21/bin/java @user_jvm_args.txt @libraries/net/neoforged/neoforge/21.1.233/unix_args.txt nogui
ExecStop=/usr/bin/screen -p 0 -S minecraft -X stuff "stop\n"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
