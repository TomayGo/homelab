# Managed by Ansible (role: pve_gdrive_backup). Mode 0600.
# OAuth の token だけは rclone が自動更新で書き換えるため /var/lib/pve-gdrive-backup/rclone.conf に分離し、
# 残りの固定設定と crypt の鍵はこの env ファイルで渡す。
RCLONE_CONFIG_GDRIVE_CLIENT_ID={{ gdrive_backup_client_id }}
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET={{ gdrive_backup_client_secret }}
RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
RCLONE_CONFIG_GDRIVE_CRYPT_TYPE=crypt
RCLONE_CONFIG_GDRIVE_CRYPT_REMOTE=gdrive:{{ pve_gdrive_backup_folder }}/dump
RCLONE_CONFIG_GDRIVE_CRYPT_FILENAME_ENCRYPTION=off
RCLONE_CONFIG_GDRIVE_CRYPT_DIRECTORY_NAME_ENCRYPTION=false
RCLONE_CONFIG_GDRIVE_CRYPT_PASSWORD={{ gdrive_backup_crypt_password_obscured }}
RCLONE_CONFIG_GDRIVE_CRYPT_PASSWORD2={{ gdrive_backup_crypt_password2_obscured }}
PVE_GDRIVE_STAGE_MOUNT={{ pve_gdrive_backup_stage_mount }}
PVE_GDRIVE_KEEP_LAST={{ pve_gdrive_backup_keep_last }}
PVE_GDRIVE_BWLIMIT={{ pve_gdrive_backup_bwlimit }}
